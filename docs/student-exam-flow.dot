digraph StudentExamFlow {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.25",
    nodesep="0.40",
    ranksep="0.50",
    splines=polyline,
    fontname="Arial"
  ];
  node [fontname="Arial", fontsize=11, color="#334155", penwidth=1.3, style="filled", fillcolor="#F8FAFC", margin="0.16,0.10"];
  edge [fontname="Arial", fontsize=9.5, color="#475569", penwidth=1.2, arrowsize=0.72];

  start [shape=ellipse, label="Start\nStudent opens exam search", fillcolor="#DBEAFE", color="#2563EB"];
  search [shape=box, style="rounded,filled", label="Search exams by query, category or code"];
  exams_store [shape=cylinder, label="quizproj.exams", fillcolor="#FFF7ED", color="#C2410C"];
  found [shape=diamond, label="Exam found?", fillcolor="#FEF3C7", color="#B45309"];
  noresults [shape=box, style="rounded,filled", label="Show no-results message", fillcolor="#FEE2E2", color="#DC2626"];
  load [shape=box, style="rounded,filled", label="Load exam by examId", fillcolor="#ECFDF5", color="#0F766E"];
  session [shape=box, style="rounded,filled", label="Start or resume ExamSession", fillcolor="#ECFDF5", color="#0F766E"];
  sessions_store [shape=cylinder, label="quizproj.examSessions", fillcolor="#FFF7ED", color="#C2410C"];
  display [shape=box, style="rounded,filled", label="Display questions, timer and saved answers\nStudent answers; every choice is auto-saved"];
  submit [shape=diamond, label="Submit clicked\nor timer expired?", fillcolor="#FEF3C7", color="#B45309"];
  calculate [shape=box, style="rounded,filled", label="Calculate Result snapshot\nscore, percent, selected and correct answers", fillcolor="#ECFDF5", color="#0F766E"];
  save [shape=box, style="rounded,filled", label="Save Result and remove active ExamSession", fillcolor="#ECFDF5", color="#0F766E"];
  results_store [shape=cylinder, label="quizproj.results", fillcolor="#FFF7ED", color="#C2410C"];
  dashboards [shape=box, style="rounded,filled", label="Display score and correct answers\nUpdate student and teacher dashboards"];
  end [shape=ellipse, label="End", fillcolor="#DCFCE7", color="#15803D"];

  start -> search;
  exams_store -> search [style=dashed, constraint=false];
  search -> found;
  found -> load [label="Yes"];
  found -> noresults [label="No"];
  noresults -> search [label="Try again", constraint=false];
  load -> noresults [style=invis, weight=20];
  load -> session;
  sessions_store -> session [style=dashed, constraint=false];
  session -> display;
  sessions_store -> display [style=dashed, constraint=false];
  display -> submit;
  submit -> display [label="No", constraint=false];
  submit -> calculate [label="Yes"];
  calculate -> save;
  results_store -> save [style=dashed, constraint=false];
  save -> dashboards;
  dashboards -> end;

  {rank=same; search; exams_store}
  {rank=same; load; noresults}
  {rank=same; session; sessions_store}
  {rank=same; save; results_store}
}
